(executables
 (names testSuite refreshOAuth2Token)
 (flags
  (:standard -w -3-6-23-27-32-33-50))
 (libraries threads ounit2 gapi-ocaml))

(rule
 (alias runtest)
 (deps
  testSuite.exe
  (glob_files test_data/*))
 (action
  (run ./testSuite.exe)))

(rule
 (alias runtest-all)
 (deps
  testSuite.exe
  (glob_files test_data/*)
  (glob_files ../../config/*))
 (action
  (run ./testSuite.exe -all)))

(rule
 (alias runtest-auth)
 (deps
  testSuite.exe
  (glob_files ../../config/*))
 (action
  (run ./testSuite.exe -service auth)))

