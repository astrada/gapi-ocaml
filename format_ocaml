#!/usr/bin/env bash

set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
repo_root=$script_dir

if ! command -v ocamlformat >/dev/null 2>&1; then
  echo "ocamlformat is not installed or not in PATH" >&2
  exit 1
fi

cd "$repo_root"

mapfile -d '' files < <(git ls-files -z -- '*.ml' '*.mli' ':!:*Service*' ':!:*Model*' ':!:*netstring*' ':!:*netsys*')

if [ "${#files[@]}" -eq 0 ]; then
  echo "No tracked .ml or .mli files found"
  exit 0
fi

ocamlformat --inplace "${files[@]}"

echo "Formatted ${#files[@]} OCaml source files"
